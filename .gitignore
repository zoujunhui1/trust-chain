# Foundry compiler output / 编译产物（可由 forge build 重新生成）
cache/
out/

# Broadcast logs / 部署广播日志（本地模拟与 dry-run 不提交）
!/contracts/broadcast
/contracts/broadcast/*/31337/
/contracts/broadcast/**/dry-run/

# Foundry docs output / 文档生成产物
docs/

# Secrets / 私钥与环境变量（绝对不能提交）
.env
.env.*
*.key
keystore/

# macOS
.DS_Store

# IDE / 编辑器配置
.idea/
.vscode/
*.iml

# 允许提交示例模板
!.env.example
