# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传）
# Copy this file to .env and fill in real values (.env is gitignored, never uploaded)

# Sepolia RPC 地址（你的 Alchemy / Infura URL）
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/你的KEY

# 部署账户私钥（0x 开头，必须有 Sepolia 测试币付 gas）—— 绝不要提交！
PRIVATE_KEY=0x你的私钥

# Etherscan API key（可选，用于自动验证合约源码；没有就留空）
ETHERSCAN_API_KEY=
