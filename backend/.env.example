# 复制为 .env 并按需修改（.env 已被 gitignore 忽略）
# Copy to .env and adjust (.env is gitignored)

# Sepolia JSON-RPC 端点（Alchemy / Infura）
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/你的KEY

# MySQL 连接串 / DSN（parseTime=true 让 driver 把 DATETIME 解析成 time.Time）
MYSQL_DSN=trustchain:trustchain@tcp(127.0.0.1:3306)/trustchain?parseTime=true&charset=utf8mb4

# 已部署的合约地址（Sepolia）
REGISTRY_ADDRESS=0xFe5Ed9702167745086196025271467918C967aa6
ESCROW_ADDRESS=0xff999aa8a09208753b34c1862fFCf45AAeE0Da2D

# 从哪个区块开始回填历史（合约部署块）
START_BLOCK=11428165

# REST API 监听地址（仅 cmd/api 使用）/ REST API listen address (cmd/api only)
API_ADDR=:8080

# 以下为可选，有默认值 / optional, have defaults
CURSOR_ID=sepolia
POLL_INTERVAL_SECONDS=12
CONFIRMATIONS=5
# 每批扫描的区块数；Alchemy 免费档 eth_getLogs 单次上限 10 个块，付费档可调大
# blocks per scan batch; Alchemy free tier caps eth_getLogs at 10 blocks/call
BATCH_SIZE=10

# DeepSeek API key（去 platform.deepseek.com 申请，需要先充值），给首页的聊天助手用。
# 留空的话 /api/chat 会直接返回 503，不影响其它接口。
# DeepSeek API key (from platform.deepseek.com, needs billing set up first), used by
# the homepage chat assistant. Leave blank and /api/chat just returns 503 — nothing
# else depends on it.
DEEPSEEK_API_KEY=
# 可选 / optional
DEEPSEEK_MODEL=deepseek-chat

# 里程碑支出凭证文件存放目录（相对路径相对启动目录），可选，有默认值
# Directory where uploaded milestone receipt files are stored (relative to the
# working directory if not absolute). Optional, has a default.
UPLOADS_DIR=./uploads
